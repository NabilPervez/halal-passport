# Map tiles and the data pipeline's geocoding both use Geoapify.
# Get a free key at https://myprojects.geoapify.com/ and, once you have one,
# restrict it to this app's origin(s) in the Geoapify dashboard.
VITE_GEOAPIFY_KEY=

# Same key, read by the Node scripts in tools/geocode/ (see
# docs/data-pipeline-plan.md) — set this in your shell, not in .env, since
# Vite only exposes VITE_-prefixed vars to the browser and these scripts run
# outside Vite.
GEOAPIFY_KEY=
